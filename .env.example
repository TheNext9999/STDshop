# Copy this file to ".env" (same folder as manage.py) and fill in real values.
# .env is for local secrets and should NEVER be committed to git.

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-long-string
DJANGO_DEBUG=True

# Google OAuth (from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Email (SMTP) — leave blank to keep printing emails to the terminal instead
# of sending real ones. For Gmail: use an "App Password", NOT your normal
# Gmail password (Google Account -> Security -> 2-Step Verification -> App passwords).
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your-gmail-address@gmail.com